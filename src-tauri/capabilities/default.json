{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos por defecto de la app",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-set-size",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-is-maximized"
  ]
}